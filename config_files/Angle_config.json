{
    "model_f": {
        "activation_function": "Tanh",
        "hidden_neurons": 32,
        "layers" : 2,
        "epochs_warm" : 1000,
        "learning_rate" : 1e-2 
    },
    "model_v": {
        "activation_function": "Tanh",
        "learning_rate": 1e-3,
        "hidden_neurons": 32,
        "layers" : 1,
        "max_iters" : 30000,
        "scheduler" : {
            "start_factor" : 1.0,
            "end_factor"   : 0.0001
        },
        "batch_size" : 10000
    },
    "model_b": {
        "activation_function": "Tanh",
        "learning_rate": 1e-3,
        "hidden_neurons": 32,
        "layers" : 2,
        "max_iters" : 50000,
        "batch_size" : 10000
    },
    "domain": {
        "N" : 1000
    },
    "init":{
        "shape" : "Circle",
        "N" : 1000,
        "radius" : 0.1
    },
    "unsafe":{
        "shape" : "Circle",
        "N" : 1000,
        "radius" : 0.1,
        "centre" : [-0.25,-0.1]
    },
    "Barrier" : true,
    "plots" : true,
    "plotting" : {
        "range" : [[-1.2,0.25],[-0.25, 0.85]],
        "contour" : false,
        "legend"  : false,
        "name" : "Angle LASA without Obstacles"
    },
    "hyperparameters" : {
        "decay_vpos" : 0.5,
        "decay_lv" : 1.5,
        "decay_tune" : 2,
        "decay_l0" : 1,
        "decay_mse" : 1,
        "decay_init" : 1,
        "decay_unsafe" : 1,
        "decay_cut" : 2,
        "decay_lb" : 3,
        "epsilon_v" : 1e-3,
        "epsilon_b" : 1e-3,
        "alpha" : 1e-4,
        "epi_bound" : 0.05,
        "eta" : 1e-2,
        "n_counter_examples" : 20
    }
}
