        "name" : "Ssshape LASA without Obstacles"
    },
    "hyperparameters" : {
        "decay_vpos" : 0.5,
        "decay_lv" : 3,
        "decay_tune" : 2,
        "decay_l0" : 1,
        "decay_l2" : 1e-7,
        "decay_mse" : 4,
        "decay_init" : 1,
        "decay_unsafe" : 1,
        "decay_cut" : 1,
        "decay_lb" : 1,
        "epsilon_v" : 1e-3,
        "epsilon_b" : 1e-3,
        "alpha" : 1e-4,
        "epi_bound" : 0.05,
        "eta" : 1e-3,
        "n_counter_examples" : 20
    }
