{
    "model_f": {
        "activation_function": "Tanh",
        "hidden_neurons": 64,
        "layers" : 2,
        "epochs_warm" : 200,
        "learning_rate" : 1e-2,
        "batch_size" : 1024 
    },
    "model_v": {
        "activation_function": "Tanh",
        "learning_rate": 1e-2,
        "hidden_neurons": 64,
        "layers" : 1,
        "max_iters" : 50000,
        "scheduler" : {
            "start_factor" : 1.0,
            "end_factor"   : 0.0001
        },
        "batch_size" : 2048,
        "batch_size_training" : 2048
    },
    "model_b": {
        "activation_function": "Tanh",
        "learning_rate": 1e-3,
        "hidden_neurons": 32,
        "layers" : 2,
        "max_iters" : 50000,
        "batch_size" : 2048
    },
    "domain": {
        "N" : 3000
    },
    "init":{
        "shape" : "Rectangle",
        "N" : 3000,
        "radius" : 0.1
    },
    "unsafe":{
        "shape" : "Rectangle",
        "N" : 3000,
        "radius" : 0.15,
        "centre" : [-0.5,0.25]
    },
    "Barrier" : true,
    "plots" : true,
    "plotting" : {
        "range" : [[-0.5,1.0],[-0.5, 1.0]],
        "contour" : false,
