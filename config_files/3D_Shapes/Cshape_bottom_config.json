    "hyperparameters" : {
        "max_iters" : 30,
        "max_iters_ft" : 30,
        "decay_mse" : 3,
        "decay_lf" : 0.0,
        "decay_vpos" : 1,
        "decay_lv" : 1,
        "decay_v0" : 1,
        "decay_init" : 1,
        "decay_unsafe" : 1,
        "decay_cut" : 1,
        "decay_lb" : 1,
        "alpha" : 1,
        "epi_bound" : 0.05,
        "eta" : 1e-4,
