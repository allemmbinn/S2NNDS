        "lr_factor" : 0.2,
        "lr_patience" :10,
        "warmup" : 10    
    },
    "model_b": {
        "activation_function": "eLU",
        "learning_rate": 1e-2,
        "learning_rate_ft": 7e-3,
        "hidden_neurons": 64,
        "layers" : 2,
        "lr_factor" : 0.2,
        "lr_patience" : 10,
        "batch_size" : 64,
        "warmup" : 10
        },

    "domain":{
